<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MultiMediaPlayer.Lab.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="using:LibVLCSharp.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MultiMediaPlayer.Lab.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MultiMediaPlayer.Lab">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
<Grid RowDefinitions="*, Auto, Auto, Auto" Margin="10">
    <Panel Grid.Row="0" Margin="0,0,0,10">
            
            <vlc:VideoView x:Name="VideoView" 
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           IsVisible="{Binding HasVideo}"/>
                           
            <TextBlock Text="🎵" 
                       FontSize="120"
                       Foreground="Gray"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       IsVisible="{Binding IsAudioOnly}"/>
                       
        </Panel>

        <!--progress bar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto">
            <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" VerticalAlignment="Center" Margin="5,0"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding PlaybackPosition, Mode=TwoWay}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding TotalTime}" VerticalAlignment="Center" Margin="5,0"/>
        </Grid>

        <!--bottom control bar -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,-5,0,5">

            <Button Grid.Column="0" 
                    Content="Open File" 
                    Command="{Binding OpenFileCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
                
                <Button Content="-1 Frame" Command="{Binding StepFrameBackwardCommand}"/>
                <Button Content="-10 sec" Command="{Binding SkipBackwardCommand}"/>
                <Button Content="▶ Play" Command="{Binding PlayCommand}"/>
                <Button Content="❚❚ Pause" Command="{Binding PauseCommand}"/>
                <Button Content="Stop" Command="{Binding StopCommand}"/>
                <Button Content="+10 sec" Command="{Binding SkipForwardCommand}"/>
                <Button Content="+1 Frame" Command="{Binding StepFrameForwardCommand}"/>
            </StackPanel>

            <!--volume control-->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        Spacing="8" 
                        VerticalAlignment="Center">
                
                <TextBlock Text="Vol:" VerticalAlignment="Center"/>
                <Slider Width="100" 
                        Minimum="0" 
                        Maximum="100" 
                        Value="{Binding Volume, Mode=TwoWay}" 
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
            <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
            <TextBox Grid.Column="0" 
                     Text="{Binding MediaUrl, Mode=TwoWay}" 
                     VerticalAlignment="Center"/>
            <Button Grid.Column="1" 
                    Content="Open URL" 
                    Command="{Binding OpenUrlCommand}" 
                    Margin="10,0,0,0" 
                    VerticalAlignment="Center"/>
        </Grid>
    </Grid>

</Window>
